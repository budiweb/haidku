# HaidKu Environment Configuration
APP_NAME=HaidKu
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost/haidku

# Database MySQL 8
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=haidku
DB_USERNAME=root
DB_PASSWORD=

# Security & Sessions
JWT_SECRET=haidku_secret_change_in_production_key_32chars
SESSION_LIFETIME=86400
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost,http://127.0.0.1

# Privacy / Health Data Policy
HEALTH_DATA_ENCRYPTION_ENABLED=false
LOG_SENSITIVE_HEALTH_DATA=false
