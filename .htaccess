<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /haidku/

    # Jangan rewrite jika file atau folder fisik nyata ada
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Alihkan semua request lain ke index.php
    RewriteRule ^ index.php [L,QSA]
</IfModule>

